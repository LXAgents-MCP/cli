{
  "name": "@lxagents-mcp/cli",
  "version": "3.0.1",
  "description": "MCP server that gives an LLM access to the host's command line and file system. Stdio only: it is loaded locally by the client and never served over a network.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "pretest": "npm run build && npm run typecheck",
    "test": "node --import tsx --test test/*.test.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LXAgents-MCP/cli.git"
  },
  "homepage": "https://github.com/LXAgents-MCP/cli#readme",
  "bugs": {
    "url": "https://github.com/LXAgents-MCP/cli/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli",
    "lxagents"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
